<section class="section na3-section">
  <div class="sec-header">
    <div class="sec-eyebrow">The Debut Edit</div>
    <h2 class="sec-title">Prarambh</h2>
  </div>

  <!-- Mobile Hero Products -->
  <div class="hero-products-mobile">
    <div class="hpm-scroll">
      <a class="hpm-card" href="/products/daisy-daze-beaded-kurti">
        <div class="hpm-img">
          <img loading="lazy" class="hpm-img-default" src="{{ 'daisy-1.jpg' | asset_url }}" alt="Daisy Daze Beaded Kurti">
          <img loading="lazy" class="hpm-img-hover" src="{{ 'daisy-2.jpg' | asset_url }}" alt="Daisy Daze Beaded Kurti hover">
        </div>
        <div class="hpm-info">
          <div class="hpm-name">Daisy Daze Beaded Kurti</div>
          <div class="hpm-price">Rs. 1,699</div>
          <button class="hpm-cta">Choose options</button>
        </div>
      </a>
      <a class="hpm-card" href="/products/berry-bloom-top">
        <div class="hpm-img">
          <img loading="lazy" class="hpm-img-default" src="{{ 'berry-1.jpg' | asset_url }}" alt="Berry Bloom Top">
          <img loading="lazy" class="hpm-img-hover" src="{{ 'berry-2.jpg' | asset_url }}" alt="Berry Bloom Top hover">
        </div>
        <div class="hpm-info">
          <div class="hpm-name">Berry Bloom Top</div>
          <div class="hpm-price">Rs. 1,499</div>
          <button class="hpm-cta">Choose options</button>
        </div>
      </a>
      <a class="hpm-card" href="/products/the-meher-kurti">
        <div class="hpm-img">
          <img loading="lazy" class="hpm-img-default" src="{{ 'meher-1.jpg' | asset_url }}" alt="The Meher Kurti">
          <img loading="lazy" class="hpm-img-hover" src="{{ 'meher-2.jpg' | asset_url }}" alt="The Meher Kurti hover">
        </div>
        <div class="hpm-info">
          <div class="hpm-name">The Meher Kurti</div>
          <div class="hpm-price">Rs. 1,999</div>
          <button class="hpm-cta">Choose options</button>
        </div>
      </a>
      <a class="hpm-card" href="/products/the-veronica-set">
        <div class="hpm-img">
          <img loading="lazy" class="hpm-img-default" src="{{ 'veronica-1.jpg' | asset_url }}" alt="The Veronica Set">
          <img loading="lazy" class="hpm-img-hover" src="{{ 'veronica-2.jpg' | asset_url }}" alt="The Veronica Set hover">
        </div>
        <div class="hpm-info">
          <div class="hpm-name">The Veronica Set</div>
          <div class="hpm-price">Rs. 2,499</div>
          <button class="hpm-cta">Choose options</button>
        </div>
      </a>
    </div>
  </div>

  <!-- Collage Grid -->
  <div class="na3-wrap">
    <div class="na3-track" id="na3Track">
      <div class="na3-block">
        <div class="na3-hero"><img loading="lazy" src="{{ 'na2-1.jpg' | asset_url }}" alt="New Arrivals"></div>
        <div class="na3-mini-grid">
          <div class="na3-mini"><img loading="lazy" src="{{ 'na2-2.jpg' | asset_url }}" alt="New Arrivals"></div>
          <div class="na3-mini"><img loading="lazy" src="{{ 'na2-3.jpg' | asset_url }}" alt="New Arrivals"></div>
          <div class="na3-mini"><img loading="lazy" src="{{ 'na2-4.jpg' | asset_url }}" alt="New Arrivals"></div>
          <div class="na3-mini"><img loading="lazy" src="{{ 'na2-5.jpg' | asset_url }}" alt="New Arrivals"></div>
        </div>
      </div>
      <div class="na3-block">
        <div class="na3-hero"><img loading="lazy" src="{{ 'na2-6.jpg' | asset_url }}" alt="New Arrivals"></div>
        <div class="na3-mini-grid">
          <div class="na3-mini"><img loading="lazy" src="{{ 'na2-7.jpg' | asset_url }}" alt="New Arrivals"></div>
          <div class="na3-mini"><img loading="lazy" src="{{ 'stl-lotus.jpg' | asset_url }}" alt="New Arrivals"></div>
          <div class="na3-mini"><img loading="lazy" src="{{ 'stl-bookshop.jpg' | asset_url }}" alt="New Arrivals"></div>
          <div class="na3-mini"><img loading="lazy" src="{{ 'stl-bench.jpg' | asset_url }}" alt="New Arrivals"></div>
        </div>
      </div>
      <div class="na3-block">
        <div class="na3-hero"><img loading="lazy" src="{{ 'stl-horses.jpg' | asset_url }}" alt="New Arrivals"></div>
        <div class="na3-mini-grid">
          <div class="na3-mini"><img loading="lazy" src="{{ 'stl-riverside.jpg' | asset_url }}" alt="New Arrivals"></div>
          <div class="na3-mini"><img loading="lazy" src="{{ 'bta-1.jpg' | asset_url }}" alt="New Arrivals"></div>
          <div class="na3-mini"><img loading="lazy" src="{{ 'bta-3.jpg' | asset_url }}" alt="New Arrivals"></div>
          <div class="na3-mini"><img loading="lazy" src="{{ 'bta-4.jpg' | asset_url }}" alt="New Arrivals"></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "New Arrivals Collage",
  "settings": [],
  "presets": [
    { "name": "New Arrivals Collage" }
  ]
}
{% endschema %}
