<section class="bta-section">
  <div class="bta-header">
    <h2 class="bta-title">Beyond the Atelier</h2>
    <p class="bta-desc">Every piece has a story before it becomes yours.<br>Step behind the finished silhouettes and into the world that brings them to life. Discover the hands, ideas, textures, and little details that shape every Indimode creation from the first spark of inspiration to the final stitch.</p>
  </div>
  <div class="bta-track-wrap">
    <div class="bta-track" id="btaTrack">
      <div class="bta-card bta-bw">
        <img loading="lazy" src="{{ 'bta-1.jpg' | asset_url }}" alt="Beyond the Atelier">
      </div>
      <div class="bta-card">
        <img loading="lazy" src="{{ 'bta-2.jpg' | asset_url }}" alt="Beyond the Atelier">
      </div>
      <div class="bta-card bta-bw">
        <img loading="lazy" src="{{ 'bta-3.jpg' | asset_url }}" alt="Beyond the Atelier">
      </div>
      <div class="bta-card">
        <img loading="lazy" src="{{ 'bta-4.jpg' | asset_url }}" alt="Beyond the Atelier">
      </div>
      <div class="bta-card bta-bw">
        <img loading="lazy" src="{{ 'bta-5.jpg' | asset_url }}" alt="Beyond the Atelier">
      </div>
      <div class="bta-card">
        <img loading="lazy" src="{{ 'bta-6.jpg' | asset_url }}" alt="Beyond the Atelier">
      </div>
    </div>
  </div>
</section>

