<section class="section na3-section">
  <div class="sec-header">
    <div class="sec-eyebrow">{{ section.settings.eyebrow }}</div>
    <h2 class="sec-title">{{ section.settings.heading }}</h2>
  </div>

  {%- if section.settings.collection != blank -%}
  <div class="hero-products-mobile">
    <div class="hpm-scroll">
      {%- for product in section.settings.collection.products limit: section.settings.product_count -%}
      <div class="hpm-card" onclick="window.location.href='{{ product.url }}'">
        <div class="hpm-img">
          <img class="hpm-img-default" src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}">
          {%- if product.images.size > 1 -%}<img class="hpm-img-hover" src="{{ product.images[1] | image_url: width: 500 }}" alt="{{ product.title | escape }}">{%- endif -%}
        </div>
        <div class="hpm-info">
          <div class="hpm-name">{{ product.title }}</div>
          <div class="hpm-price">({{ product.price | money }})</div>
          <button type="button" class="hpm-cta" onclick="event.stopPropagation();window.location.href='{{ product.url }}'">Choose options</button>
        </div>
      </div>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Trending Now",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Debut Edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Prarambh" },
    { "type": "collection", "id": "collection", "label": "Collection to feature" },
    { "type": "range", "id": "product_count", "label": "Number of products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Trending Now" }]
}
{% endschema %}
