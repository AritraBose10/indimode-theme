<section class="festive-section">
  <div class="container">
    <div class="sec-header">
      <div class="sec-eyebrow">Celebrate in Style</div>
      <h2 class="sec-title">Choose Your Mode</h2>
    </div>
    <div class="festive-stack">
      <div class="fc-card">
        <div class="fc-card-img">
          <img loading="lazy" src="{{ 'heer-3.jpg' | asset_url }}" alt="The Heer Set">
          <button class="fc-card-bookmark" aria-label="Save">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z"/></svg>
          </button>
        </div>
        <div class="fc-card-info">
          <div>
            <div class="fc-card-name">The Heer Set</div>
            <div class="fc-card-price">Rs. 2,999</div>
          </div>
          <a href="/products/the-heer-set" class="fc-card-add">+ Add</a>
        </div>
      </div>
      <div class="fc-card">
        <div class="fc-card-img">
          <img loading="lazy" src="{{ 'gulaab-3.jpg' | asset_url }}" alt="The Gulaab Set">
          <button class="fc-card-bookmark" aria-label="Save">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z"/></svg>
          </button>
        </div>
        <div class="fc-card-info">
          <div>
            <div class="fc-card-name">The Gulaab Set</div>
            <div class="fc-card-price">Rs. 2,499</div>
          </div>
          <a href="/products/the-gulaab-set" class="fc-card-add">+ Add</a>
        </div>
      </div>
      <div class="fc-card">
        <div class="fc-card-img">
          <img loading="lazy" src="{{ 'sonika-1.jpg' | asset_url }}" alt="The Sonika Kurti">
          <button class="fc-card-bookmark" aria-label="Save">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z"/></svg>
          </button>
        </div>
        <div class="fc-card-info">
          <div>
            <div class="fc-card-name">The Sonika Kurti</div>
            <div class="fc-card-price">Rs. 1,699</div>
          </div>
          <a href="/products/the-sonika-kurti" class="fc-card-add">+ Add</a>
        </div>
      </div>
      <div class="fc-card">
        <div class="fc-card-img">
          <img loading="lazy" src="{{ 'aditi-1.jpg' | asset_url }}" alt="The Aditi Kurti">
          <button class="fc-card-bookmark" aria-label="Save">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z"/></svg>
          </button>
        </div>
        <div class="fc-card-info">
          <div>
            <div class="fc-card-name">The Aditi Kurti</div>
            <div class="fc-card-price">Rs. 1,699</div>
          </div>
          <a href="/products/the-aditi-kurti" class="fc-card-add">+ Add</a>
        </div>
      </div>
    </div>
    <div class="festive-stack-hint">← Swipe or click to browse the collection →</div>
  </div>
</section>

{% schema %}
{
  "name": "Festive Collection",
  "settings": [],
  "presets": [
    { "name": "Festive Collection" }
  ]
}
{% endschema %}
