<div class="search-section">
  <div class="coll-hero"><h1>Search results</h1>{%- if search.performed -%}<p>{{ search.results_count }} results for "{{ search.terms }}"</p>{%- endif -%}</div>

  <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:480px;margin:0 auto 32px;">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products..." class="search-input" style="width:100%;">
    <input type="hidden" name="type" value="product">
  </form>

  {%- if search.performed -%}
    <div class="coll-grid" style="max-width:1400px;margin:0 auto;padding:0 40px;">
      {%- for item in search.results -%}
        <div class="product-card" onclick="window.location.href='{{ item.url }}'">
          <div class="product-img">
            <div class="ph"><img src="{{ item.featured_image | image_url: width: 500 }}" alt="{{ item.title | escape }}"></div>
            <span class="product-wishlist" data-product-handle="{{ item.handle }}">&#9825;</span>
          </div>
          <div class="product-info">
            <div class="product-name">{{ item.title }}</div>
            <div class="product-price">({{ item.price | money }})</div>
          </div>
        </div>
      {%- else -%}
        <p>No results found.</p>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
