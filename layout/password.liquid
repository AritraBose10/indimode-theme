<!doctype html>
<html class="js full-height" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }} — Coming Soon</title>
    <meta name="description" content="{{ page_description | escape }}">

    {% render 'meta-tags' %}
    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

    <style>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      .shopify-section, #shopify-section-header, .social-icons, .list-social, [class*="social"], .header-wrapper, .footer { display: none !important; }

      body {
        font-family: 'Poppins', sans-serif;
        background: #000;
        color: #f5ede3;
        overflow: hidden;
        height: 100vh;
      }

      .pw-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
        height: 100dvh;
        position: relative;
        padding: 10px 24px 30px;
      }

      /* Soft glow behind logo */
      .pw-glow {
        position: absolute;
        top: 30%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 500px;
        height: 400px;
        background: radial-gradient(ellipse, rgba(201,169,110,0.06) 0%, transparent 70%);
        pointer-events: none;
        opacity: 0;
      }

      /* Particles */
      .particles { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
      .particle {
        position: absolute;
        width: 2px; height: 2px;
        background: rgba(201,169,110,0.25);
        border-radius: 50%;
        opacity: 0;
      }

      /* Logo image */
      .pw-logo {
        position: relative;
        z-index: 2;
        margin-bottom: 24px;
        margin-top: -80px;
        opacity: 0;
      }
      .pw-logo img {
        width: 240px;
        max-width: 55vw;
        height: auto;
      }

      /* Content */
      .pw-center {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 520px;
      }
      .pw-divider {
        width: 50px; height: 1px;
        background: #c9a96e;
        margin: 0 auto 14px;
        opacity: 0;
      }
      .pw-heading {
        font-size: 13px; font-weight: 600;
        letter-spacing: 6px; text-transform: uppercase;
        color: #c9a96e; margin-bottom: 10px;
        opacity: 0;
      }
      .pw-subtitle {
        font-family: 'Cormorant Garamond', serif;
        font-size: 34px; font-weight: 300;
        margin-bottom: 10px; line-height: 1.3;
        opacity: 0;
      }
      .pw-desc {
        font-size: 14px;
        color: rgba(245,237,227,0.45);
        line-height: 1.7; margin-bottom: 24px;
        opacity: 0;
      }

      /* Form */
      .pw-form { width: 100%; margin-bottom: 10px; opacity: 0; position: relative; }
      .pw-success {
        text-align: center; padding: 16px 0;
        display: none;
      }
      .pw-success .pw-check {
        width: 36px; height: 36px; border-radius: 50%;
        border: 1.5px solid #c9a96e;
        display: inline-flex; align-items: center; justify-content: center;
        margin-bottom: 10px; color: #c9a96e; font-size: 16px;
      }
      .pw-success p {
        font-family: 'Cormorant Garamond', serif;
        font-size: 20px; font-weight: 300; color: #f5ede3;
        margin-bottom: 4px;
      }
      .pw-success span {
        font-size: 11px; color: rgba(245,237,227,0.35);
      }
      .pw-form form {
        display: flex;
        border: 1px solid rgba(201,169,110,0.25);
      }
      .pw-form input[type="email"] {
        flex: 1; padding: 14px 18px;
        border: none; background: transparent;
        font-family: 'Poppins', sans-serif;
        font-size: 13px; color: #f5ede3; outline: none;
      }
      .pw-form input[type="email"]::placeholder { color: rgba(245,237,227,0.3); }
      .pw-form button {
        padding: 14px 28px;
        background: #b43217; color: #faf6f1;
        border: none; font-family: 'Poppins', sans-serif;
        font-size: 11px; font-weight: 600;
        letter-spacing: 3px; text-transform: uppercase;
        cursor: pointer; transition: background 0.3s; white-space: nowrap;
      }
      .pw-form button:hover { background: #8f2812; }


      /* Password */
      .pw-pass-link {
        font-size: 10px; color: rgba(245,237,227,0.2);
        cursor: pointer; background: none; border: none;
        font-family: 'Poppins', sans-serif;
        text-decoration: underline; text-underline-offset: 3px;
        transition: color 0.3s; opacity: 0;
      }
      .pw-pass-link:hover { color: #c9a96e; }

      /* Modal */
      .pw-modal-bg {
        position: fixed; inset: 0; background: rgba(0,0,0,0.8);
        z-index: 1000; opacity: 0; visibility: hidden;
        transition: all 0.3s; display: flex;
        align-items: center; justify-content: center;
      }
      .pw-modal-bg.active { opacity: 1; visibility: visible; }
      .pw-modal {
        background: #111; border: 1px solid rgba(201,169,110,0.15);
        padding: 40px; max-width: 360px; width: 90%;
        text-align: center; position: relative;
        transform: translateY(20px); transition: transform 0.3s;
      }
      .pw-modal-bg.active .pw-modal { transform: translateY(0); }
      .pw-modal-x {
        position: absolute; top: 12px; right: 12px;
        background: none; border: none; font-size: 16px;
        cursor: pointer; color: rgba(245,237,227,0.3);
      }
      .pw-modal-x:hover { color: #f5ede3; }
      .pw-modal h3 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 20px; font-weight: 400; margin-bottom: 18px;
      }
      .pw-modal form { display: flex; flex-direction: column; gap: 10px; }
      .pw-modal input[type="password"] {
        width: 100%; padding: 12px 16px;
        border: 1px solid rgba(201,169,110,0.2);
        background: transparent; font-family: 'Poppins', sans-serif;
        font-size: 12px; color: #f5ede3; outline: none;
      }
      .pw-modal input[type="password"]:focus { border-color: #c9a96e; }
      .pw-modal button[type="submit"] {
        padding: 12px; background: #b43217; color: #f5ede3;
        border: none; font-family: 'Poppins', sans-serif;
        font-size: 10px; font-weight: 600; letter-spacing: 2px;
        text-transform: uppercase; cursor: pointer;
      }
      .pw-modal button[type="submit"]:hover { background: #8f2812; }

      .pw-footer {
        position: absolute; bottom: 8px; left: 0; right: 0;
        text-align: center; font-size: 8px;
        color: rgba(245,237,227,0.12);
        z-index: 2;
      }

      @media (max-width: 600px) {
        .pw-logo { margin-top: -40px; }
        .pw-logo img { width: 200px; }
        .pw-subtitle { font-size: 24px; }
        .pw-desc { font-size: 12px; }
        .pw-form form { flex-direction: column; border: none; }
        .pw-form input[type="email"] {
          border: 1px solid rgba(201,169,110,0.25);
          margin-bottom: 6px;
        }
      }
    </style>
  </head>

  <body>
    <div class="particles" id="particles"></div>

    <!-- Background elements -->
    <div style="position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden;">

      <!-- Large mandala top-right -->
      <svg style="position:absolute;top:-120px;right:-120px;width:480px;opacity:0;" id="bg1" viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="95" fill="none" stroke="rgba(201,169,110,0.07)" stroke-width="0.4"/>
        <circle cx="100" cy="100" r="80" fill="none" stroke="rgba(201,169,110,0.06)" stroke-width="0.4"/>
        <circle cx="100" cy="100" r="65" fill="none" stroke="rgba(201,169,110,0.05)" stroke-width="0.4"/>
        <circle cx="100" cy="100" r="50" fill="none" stroke="rgba(201,169,110,0.04)" stroke-width="0.4"/>
        <circle cx="100" cy="100" r="35" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.4"/>
        <path d="M100,5 L100,195 M5,100 L195,100 M22,22 L178,178 M178,22 L22,178" fill="none" stroke="rgba(201,169,110,0.04)" stroke-width="0.3"/>
        <path d="M100,5 Q130,50 100,100 Q70,50 100,5" fill="none" stroke="rgba(201,169,110,0.035)" stroke-width="0.3"/>
        <path d="M195,100 Q150,130 100,100 Q150,70 195,100" fill="none" stroke="rgba(201,169,110,0.035)" stroke-width="0.3"/>
        <path d="M100,195 Q70,150 100,100 Q130,150 100,195" fill="none" stroke="rgba(201,169,110,0.035)" stroke-width="0.3"/>
        <path d="M5,100 Q50,70 100,100 Q50,130 5,100" fill="none" stroke="rgba(201,169,110,0.035)" stroke-width="0.3"/>
      </svg>

      <!-- Large mandala bottom-left -->
      <svg style="position:absolute;bottom:-140px;left:-140px;width:520px;opacity:0;" id="bg2" viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="95" fill="none" stroke="rgba(201,169,110,0.06)" stroke-width="0.4"/>
        <circle cx="100" cy="100" r="78" fill="none" stroke="rgba(201,169,110,0.05)" stroke-width="0.4"/>
        <circle cx="100" cy="100" r="60" fill="none" stroke="rgba(201,169,110,0.04)" stroke-width="0.4"/>
        <circle cx="100" cy="100" r="42" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.4"/>
        <path d="M100,5 L100,195 M5,100 L195,100 M22,22 L178,178 M178,22 L22,178" fill="none" stroke="rgba(201,169,110,0.035)" stroke-width="0.3"/>
        <path d="M100,5 Q140,60 100,100 Q60,60 100,5" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.3"/>
        <path d="M195,100 Q140,140 100,100 Q140,60 195,100" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.3"/>
        <path d="M100,195 Q60,140 100,100 Q140,140 100,195" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.3"/>
        <path d="M5,100 Q60,60 100,100 Q60,140 5,100" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.3"/>
      </svg>

      <!-- Arch top-left -->
      <svg style="position:absolute;top:30px;left:25px;width:140px;opacity:0;" id="bg3" viewBox="0 0 100 150">
        <path d="M5,150 L5,50 Q5,5 50,5 Q95,5 95,50 L95,150" fill="none" stroke="rgba(201,169,110,0.06)" stroke-width="0.5"/>
        <path d="M20,150 L20,55 Q20,20 50,20 Q80,20 80,55 L80,150" fill="none" stroke="rgba(201,169,110,0.04)" stroke-width="0.5"/>
        <path d="M35,150 L35,60 Q35,35 50,35 Q65,35 65,60 L65,150" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.5"/>
      </svg>

      <!-- Arch bottom-right -->
      <svg style="position:absolute;bottom:30px;right:25px;width:130px;opacity:0;" id="bg4" viewBox="0 0 100 150">
        <path d="M5,150 L5,50 Q5,5 50,5 Q95,5 95,50 L95,150" fill="none" stroke="rgba(201,169,110,0.06)" stroke-width="0.5"/>
        <path d="M20,150 L20,55 Q20,20 50,20 Q80,20 80,55 L80,150" fill="none" stroke="rgba(201,169,110,0.04)" stroke-width="0.5"/>
        <path d="M35,150 L35,60 Q35,35 50,35 Q65,35 65,60 L65,150" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.5"/>
      </svg>

      <!-- Ornamental line left -->
      <svg style="position:absolute;top:50%;left:0;width:18vw;opacity:0;transform:translateY(-50%);" id="bg5" viewBox="0 0 200 20">
        <line x1="0" y1="10" x2="185" y2="10" stroke="rgba(201,169,110,0.05)" stroke-width="0.5"/>
        <circle cx="190" cy="10" r="4" fill="none" stroke="rgba(201,169,110,0.06)" stroke-width="0.5"/>
        <circle cx="190" cy="10" r="1.5" fill="rgba(201,169,110,0.04)"/>
      </svg>

      <!-- Ornamental line right -->
      <svg style="position:absolute;top:50%;right:0;width:18vw;opacity:0;transform:translateY(-50%);" id="bg6" viewBox="0 0 200 20">
        <line x1="15" y1="10" x2="200" y2="10" stroke="rgba(201,169,110,0.05)" stroke-width="0.5"/>
        <circle cx="10" cy="10" r="4" fill="none" stroke="rgba(201,169,110,0.06)" stroke-width="0.5"/>
        <circle cx="10" cy="10" r="1.5" fill="rgba(201,169,110,0.04)"/>
      </svg>

      <!-- Paisley curve top-left area -->
      <svg style="position:absolute;top:15%;left:8%;width:160px;opacity:0;" id="bg7" viewBox="0 0 100 160">
        <path d="M70,150 Q10,120 20,60 Q30,10 70,20 Q95,28 85,60 Q75,90 50,80" fill="none" stroke="rgba(201,169,110,0.045)" stroke-width="0.5"/>
        <path d="M65,130 Q20,105 28,58 Q35,20 65,28 Q82,34 75,58 Q68,80 50,72" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.4"/>
      </svg>

      <!-- Paisley curve bottom-right area -->
      <svg style="position:absolute;bottom:15%;right:8%;width:150px;opacity:0;transform:rotate(180deg);" id="bg8" viewBox="0 0 100 160">
        <path d="M70,150 Q10,120 20,60 Q30,10 70,20 Q95,28 85,60 Q75,90 50,80" fill="none" stroke="rgba(201,169,110,0.045)" stroke-width="0.5"/>
        <path d="M65,130 Q20,105 28,58 Q35,20 65,28 Q82,34 75,58 Q68,80 50,72" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.4"/>
      </svg>

      <!-- Vertical dotted line left -->
      <svg style="position:absolute;top:10%;left:5%;height:30%;width:20px;opacity:0;" id="bg9" viewBox="0 0 10 200">
        <line x1="5" y1="0" x2="5" y2="200" stroke="rgba(201,169,110,0.04)" stroke-width="0.4" stroke-dasharray="4 8"/>
      </svg>

      <!-- Vertical dotted line right -->
      <svg style="position:absolute;bottom:10%;right:5%;height:30%;width:20px;opacity:0;" id="bg10" viewBox="0 0 10 200">
        <line x1="5" y1="0" x2="5" y2="200" stroke="rgba(201,169,110,0.04)" stroke-width="0.4" stroke-dasharray="4 8"/>
      </svg>

      <!-- Small mandala center-left -->
      <svg style="position:absolute;top:35%;left:3%;width:80px;opacity:0;" id="bg11" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(201,169,110,0.04)" stroke-width="0.4"/>
        <circle cx="50" cy="50" r="30" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.4"/>
        <path d="M50,5 L50,95 M5,50 L95,50" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.3"/>
      </svg>

      <!-- Small mandala center-right -->
      <svg style="position:absolute;top:60%;right:3%;width:90px;opacity:0;" id="bg12" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(201,169,110,0.04)" stroke-width="0.4"/>
        <circle cx="50" cy="50" r="30" fill="none" stroke="rgba(201,169,110,0.03)" stroke-width="0.4"/>
        <circle cx="50" cy="50" r="15" fill="none" stroke="rgba(201,169,110,0.025)" stroke-width="0.4"/>
        <path d="M50,5 L50,95 M5,50 L95,50 M18,18 L82,82 M82,18 L18,82" fill="none" stroke="rgba(201,169,110,0.025)" stroke-width="0.3"/>
      </svg>

      <!-- Corner flourish top-right -->
      <svg style="position:absolute;top:0;right:0;width:200px;opacity:0;" id="bg13" viewBox="0 0 200 200">
        <path d="M200,0 Q200,80 160,120 Q130,150 80,140" fill="none" stroke="rgba(201,169,110,0.05)" stroke-width="0.5"/>
        <path d="M200,0 Q190,60 155,95 Q125,125 85,118" fill="none" stroke="rgba(201,169,110,0.035)" stroke-width="0.4"/>
      </svg>

      <!-- Corner flourish bottom-left -->
      <svg style="position:absolute;bottom:0;left:0;width:200px;opacity:0;" id="bg14" viewBox="0 0 200 200">
        <path d="M0,200 Q0,120 40,80 Q70,50 120,60" fill="none" stroke="rgba(201,169,110,0.05)" stroke-width="0.5"/>
        <path d="M0,200 Q10,140 45,105 Q75,75 115,82" fill="none" stroke="rgba(201,169,110,0.035)" stroke-width="0.4"/>
      </svg>
    </div>

    <div class="pw-page">
      <div class="pw-glow" id="glow"></div>

      <div class="pw-logo" id="logo">
        <img src="{{ 'indimode-logo.png' | asset_url }}" alt="{{ shop.name }}">
      </div>

      <div class="pw-center">
        <div class="pw-divider" id="a1"></div>
        <div class="pw-heading" id="a2">Coming Soon</div>
        <div class="pw-subtitle" id="a3">Something Beautiful is Being Crafted</div>
        <p class="pw-desc" id="a4">We're weaving together a collection that celebrates India's rich textile heritage. Be the first to experience handcrafted ethnic wear made with love.</p>
        <div class="pw-form" id="a5">
          <div id="pwFormWrap">
            {%- form 'customer', id: 'ContactPassword' -%}
              <input type="email" name="contact[email]" placeholder="Enter your email address" required autocomplete="email">
              <button type="submit">Notify Me</button>
            {%- endform -%}
          </div>
          <div class="pw-success" id="pwSuccess">
            <div class="pw-check">✓</div>
            <p>Thank You</p>
            <span>We'll notify you when we launch.</span>
          </div>
        </div>
        <button class="pw-pass-link" id="a7" onclick="document.getElementById('pwModal').classList.add('active')">Enter using password</button>
      </div>

      <div style="display:none!important;visibility:hidden!important;height:0!important;overflow:hidden!important;">{{ content_for_layout }}</div>
    </div>

    <div class="pw-footer">© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</div>

    <div class="pw-modal-bg" id="pwModal">
      <div class="pw-modal">
        <button class="pw-modal-x" onclick="document.getElementById('pwModal').classList.remove('active')">✕</button>
        <h3>Enter Store Password</h3>
        {%- form 'storefront_password' -%}
          <input type="password" name="password" placeholder="Password" autofocus>
          <button type="submit">Enter</button>
        {%- endform -%}
      </div>
    </div>

    <script>
    (function() {
      var pc = document.getElementById('particles');
      for (var i = 0; i < 25; i++) {
        var p = document.createElement('div');
        p.className = 'particle';
        p.style.left = Math.random() * 100 + '%';
        p.style.top = Math.random() * 100 + '%';
        var s = (Math.random() * 2 + 1) + 'px';
        p.style.width = s; p.style.height = s;
        pc.appendChild(p);
        gsap.to(p, {
          opacity: Math.random() * 0.3 + 0.1,
          y: -50 - Math.random() * 60,
          x: (Math.random() - 0.5) * 30,
          duration: 5 + Math.random() * 5,
          delay: Math.random() * 6,
          repeat: -1, yoyo: true, ease: 'sine.inOut'
        });
      }

      var tl = gsap.timeline();

      // Logo: scale up from small + fade in
      tl.fromTo('#logo', {
        opacity: 0, scale: 0.85, y: 10
      }, {
        opacity: 1, scale: 1, y: 0,
        duration: 2.5,
        ease: 'power2.out'
      }, 0.5);

      // Glow appears with logo
      tl.to('#glow', {
        opacity: 1, duration: 2, ease: 'sine.inOut'
      }, 1);
      tl.to('#glow', {
        opacity: 0.4, duration: 1.5, ease: 'sine.inOut'
      }, 3);

      // Content staggers in
      var items = ['#a1','#a2','#a3','#a4','#a5','#a7'];
      items.forEach(function(id, i) {
        tl.fromTo(id, {
          opacity: 0, y: 12
        }, {
          opacity: 1, y: 0,
          duration: 0.8,
          ease: 'power2.out'
        }, 3 + i * 0.2);
      });

      // Background elements fade in
      gsap.to('#bg1', { opacity: 1, rotation: 15, duration: 4, delay: 0.5, ease: 'power1.out' });
      gsap.to('#bg2', { opacity: 1, rotation: -10, duration: 4, delay: 0.8, ease: 'power1.out' });
      gsap.to('#bg3', { opacity: 1, y: 8, duration: 3, delay: 1.2, ease: 'power1.out' });
      gsap.to('#bg4', { opacity: 1, y: -8, duration: 3, delay: 1.5, ease: 'power1.out' });
      gsap.to('#bg5', { opacity: 1, x: 10, duration: 3, delay: 1.8, ease: 'power1.out' });
      gsap.to('#bg6', { opacity: 1, x: -10, duration: 3, delay: 1.8, ease: 'power1.out' });
      gsap.to('#bg7', { opacity: 1, y: 5, duration: 3.5, delay: 1, ease: 'power1.out' });
      gsap.to('#bg8', { opacity: 1, y: -5, duration: 3.5, delay: 1.3, ease: 'power1.out' });
      gsap.to('#bg9', { opacity: 1, duration: 3, delay: 2, ease: 'power1.out' });
      gsap.to('#bg10', { opacity: 1, duration: 3, delay: 2.2, ease: 'power1.out' });
      gsap.to('#bg11', { opacity: 1, rotation: 10, duration: 3, delay: 1.5, ease: 'power1.out' });
      gsap.to('#bg12', { opacity: 1, rotation: -10, duration: 3, delay: 1.8, ease: 'power1.out' });
      gsap.to('#bg13', { opacity: 1, duration: 3, delay: 0.8, ease: 'power1.out' });
      gsap.to('#bg14', { opacity: 1, duration: 3, delay: 1, ease: 'power1.out' });

      // Slow continuous rotation on mandalas
      gsap.to('#bg1', { rotation: '+=360', duration: 120, repeat: -1, ease: 'none', delay: 5 });
      gsap.to('#bg2', { rotation: '-=360', duration: 150, repeat: -1, ease: 'none', delay: 5 });
      gsap.to('#bg11', { rotation: '+=360', duration: 90, repeat: -1, ease: 'none', delay: 5 });
      gsap.to('#bg12', { rotation: '-=360', duration: 100, repeat: -1, ease: 'none', delay: 5 });

      document.getElementById('pwModal').addEventListener('click', function(e) {
        if (e.target === this) this.classList.remove('active');
      });

      var cf = document.getElementById('ContactPassword');
      if (cf) {
        cf.addEventListener('submit', function(e) {
          e.preventDefault();
          var fd = new FormData(cf);
          fetch(cf.action, { method: 'POST', body: fd }).catch(function(){});
          gsap.to('#pwFormWrap', {
            opacity: 0, y: -10, duration: 0.4, ease: 'power2.in',
            onComplete: function() {
              document.getElementById('pwFormWrap').style.display = 'none';
              var s = document.getElementById('pwSuccess');
              s.style.display = 'block';
              gsap.fromTo(s, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' });
            }
          });
        });
      }
    })();
    </script>
  </body>
</html>
