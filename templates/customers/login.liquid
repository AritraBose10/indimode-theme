<div class="login-section">
  <div class="login-form">
    <h2>Welcome Back</h2>
    <p>Sign in to your {{ shop.name }} account</p>

    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <p style="color:var(--red);">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <label for="CustomerEmail">Email</label>
      <input type="email" name="customer[email]" id="CustomerEmail" placeholder="your@email.com" autocomplete="email" required>

      {%- if form.password_needed -%}
      <label for="CustomerPassword">Password</label>
      <input type="password" name="customer[password]" id="CustomerPassword" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" autocomplete="current-password" required>
      {%- endif -%}

      <button type="submit">Sign In</button>
      {%- if form.password_needed -%}
      <div class="login-link"><a href="#" onclick="event.preventDefault();document.getElementById('RecoverPassword').style.display='block';this.closest('form').style.display='none';">Forgot your password?</a></div>
      {%- endif -%}
    {%- endform -%}

    <div id="RecoverPassword" style="display:none;">
      {%- form 'recover_customer_password' -%}
        <label for="RecoverEmail">Email</label>
        <input type="email" name="email" id="RecoverEmail" placeholder="your@email.com" required>
        <button type="submit">Send reset link</button>
      {%- endform -%}
    </div>

    <div class="login-link">Don't have an account? <a href="{{ routes.account_register_url }}">Create one</a></div>
  </div>
</div>
